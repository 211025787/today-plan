<?xml version="1.0" encoding="utf-8"?>
<!-- 深色模式 API 31+：同样不画系统启动图标，只留与 WarmSplash 一致的近黑底 -->
<resources>
    <style name="Theme.FocusList" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowBackground">#FF1C1714</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_brand_full</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenBackground">#FF1C1714</item>
    </style>
</resources>
