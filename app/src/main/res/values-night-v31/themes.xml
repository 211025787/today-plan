<?xml version="1.0" encoding="utf-8"?>
<!-- 深色模式下 API 31+ 的系统启动画面：同样不显示大图标，底色与 WarmSplash 深色一致 -->
<resources>
    <style name="Theme.FocusList" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowBackground">#FF1C1714</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_brand</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenBackground">#FF1C1714</item>
    </style>
</resources>
