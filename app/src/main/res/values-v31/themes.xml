<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ 专用：系统启动画面不画任何图标，只留一层与 WarmSplash 相同的暖白底。

  系统会按自己的尺寸放大 windowSplashScreenAnimatedIcon，真机上比应用内图标大两倍多，
  怎么调 drawable 的 dp 都对不上，点开就会「先一个大图标、再突然变成小图标」。
  干脆退回透明占位：底色一致，应用第一帧直接就是开屏页（小图标 + 暖历 + 手写名言），
  两段之间没有可察觉的切换。

  注意：同名 style 在不同限定符下是整体替换，不会合并属性，
  所以 values/themes.xml 里的三个属性必须原样保留在这里。
-->
<resources>
    <style name="Theme.FocusList" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowBackground">#FFFFF7EF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenBackground">#FFFFF7EF</item>
    </style>
</resources>
