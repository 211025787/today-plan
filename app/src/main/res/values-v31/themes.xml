<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ 专用：系统启动画面画一枚**大**的日轮图标，底色与 WarmSplash 的暖白一致。

  系统会按自己的尺寸放大 windowSplashScreenAnimatedIcon（本机实测约 2.2 倍），
  所以 splash_brand 里画 72dp 的方块，放大后约 157dp —— 这是有意的：
  应用开屏页的首帧把图标放大 1.22 倍（60dp × 1.22 ≈ 73dp），接在 157dp 之后，
  再用 1600ms 匀速收拢到 60dp，形成「大图标缓缓落位」的入场。

  注意：同名 style 在不同限定符下是整体替换，不会合并属性，
  所以 values/themes.xml 里的三个属性必须原样保留在这里。
-->
<resources>
    <style name="Theme.FocusList" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowBackground">#FFFFF7EF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_brand</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenBackground">#FFFFF7EF</item>
    </style>
</resources>
