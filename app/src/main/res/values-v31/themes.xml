<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ 专用：系统启动画面只画一枚很小的日轮图标，底色与 WarmSplash 的暖白一致。

  两条实测结论决定了这里的写法：
  1. 系统会按自己的尺寸放大 windowSplashScreenAnimatedIcon（本机约 2.2 倍），
     drawable 里写多少 dp 都不会原样显示 —— 所以尺寸要按倍率反推；
  2. 完全不画图标（透明占位）会留下几百毫秒纯色，看起来就是「点开先白一下」。

  splash_small_icon 画的是 28dp 方块，放大后 ≈ 61dp，正好接上应用开屏里那枚 60dp 图标，
  第一眼就有内容、又不会出现「大图标」或尺寸跳变。

  注意：同名 style 在不同限定符下是整体替换，不会合并属性，
  所以 values/themes.xml 里的三个属性必须原样保留在这里。
-->
<resources>
    <style name="Theme.FocusList" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowBackground">#FFFFF7EF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_small_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenBackground">#FFFFF7EF</item>
    </style>
</resources>
