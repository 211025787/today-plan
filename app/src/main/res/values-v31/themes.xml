<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ 专用：系统启动画面只画**一枚图标**，尺寸和应用开屏页里的那枚一样。

  系统会按自己的尺寸放大 windowSplashScreenAnimatedIcon（本机实测约 2.2 倍），
  所以 splash_small_icon 里画 28dp 的方块，放大后约 61dp ≈ 应用内的 60dp。

  这样「系统帧（只有图标）→ 开屏页（图标 + 暖历）」之间图标是**完全不动**的，
  唯一的过渡是「暖历」两个字缓缓浮现（WarmSplash 里 1200ms 淡入）。
  千万不要在这里放大图标再让应用内收拢——那会被读成「图标慢慢变小」。

  注意：同名 style 在不同限定符下是整体替换，不会合并属性，
  所以 values/themes.xml 里的三个属性必须原样保留在这里。
-->
<resources>
    <style name="Theme.FocusList" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowBackground">#FFFFF7EF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_small_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenBackground">#FFFFF7EF</item>
    </style>
</resources>
