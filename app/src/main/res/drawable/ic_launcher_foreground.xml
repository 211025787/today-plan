<!--
  启动图标前景（「暖历」）：日轮。

  范式按 GPT / 抖音 / Grok / X 那一类图标来：纯色高对比底 + 单个几何符号 +
  大留白，不画日历界面缩略图、不用渐变、不塞格子与装订环。
  符号只有两笔：一个粗线圆角方框（一页日历 / 「日」字外框）+
  中间一颗实心暖橙圆（今天的太阳）。

  主体边长 42dp，在自适应图标 66dp 的可见区里约占六成，
  48dp 桌面尺寸下靠剪影识别，不靠细节。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角方框：x/y 33..75，圆角 11，笔画 6 -->
    <path
        android:strokeColor="#FFF7EF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M44,33h20a11,11 0 0 1 11,11v20a11,11 0 0 1 -11,11h-20a11,11 0 0 1 -11,-11v-20a11,11 0 0 1 11,-11z" />

    <!-- 今天的太阳 -->
    <path
        android:fillColor="#FF9F5A"
        android:pathData="M54,45a9,9 0 1 1 0,18a9,9 0 1 1 0,-18z" />
</vector>
