<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 系统启动画面的图标：「首帧大图标」，与应用开屏里那枚图标同款、同比例。

  两段交接的几何关系（这是不再有大小跳变的关键）：
    - 应用开屏图标最终是 60dp 方块 / 22dp 圆角，内部日轮约 30dp；
    - 应用首帧只放大 1.22 倍 → 约 73dp 方块 / 26.8dp 圆角 / 37dp 日轮；
    - 所以这里在 108dp 画布中心画 72dp 方块 / 27dp 圆角 / 36dp 日轮，
      与应用首帧几乎逐像素重合；随后应用内用 1100ms 匀速 tween 收到 60dp。
      幅度只有 13dp、时间拉到 1 秒多，观感是缓缓收拢而不是「突然变小」。

  方块底色与深色开屏一致，另加一圈极淡描边：浅色暖白底上靠深色块识别，
  深色近黑底上靠描边 + 日轮识别，两种主题下都不会消失。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角方块：18..90（72dp），圆角 27（squircle，兼容厂商圆形遮罩） -->
    <path
        android:fillColor="#FF1C1714"
        android:pathData="M45,18h18a27,27 0 0 1 27,27v18a27,27 0 0 1 -27,27h-18a27,27 0 0 1 -27,-27v-18a27,27 0 0 1 27,-27z" />
    <path
        android:strokeColor="#40FFF7EF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M45,18h18a27,27 0 0 1 27,27v18a27,27 0 0 1 -27,27h-18a27,27 0 0 1 -27,-27v-18a27,27 0 0 1 27,-27z" />

    <!-- 日轮外框：36..72（36dp），笔画 5.1 -->
    <path
        android:strokeColor="#FFF7EF"
        android:strokeWidth="5.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M44,36h20a8,8 0 0 1 8,8v20a8,8 0 0 1 -8,8h-20a8,8 0 0 1 -8,-8v-20a8,8 0 0 1 8,-8z" />

    <!-- 今天的太阳 -->
    <path
        android:fillColor="#FF9F5A"
        android:pathData="M54,46.3a7.7,7.7 0 1 1 0,15.4a7.7,7.7 0 1 1 0,-15.4z" />
</vector>
