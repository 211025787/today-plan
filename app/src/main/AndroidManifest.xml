<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 闹钟提醒权限：用于任务到期提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 前台服务权限：番茄钟计时在后台持续运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 悬浮计时胶囊：应用退到后台时在桌面上方显示当前计时 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 旅游规划：地图底图与真实道路路线需要联网；行程数据仍只保存在本机 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FocusListApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusList"
        tools:targetApi="34"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 小组件点击快捷进入番茄钟页 -->
            <intent-filter>
                <action android:name="com.focuslist.app.action.OPEN_TIMER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 番茄钟前台计时服务 -->
        <service
            android:name=".timer.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pomodoro_timer" />
        </service>

        <!-- 计划秒表前台服务：息屏/后台持续计时 + 灵动岛计时通知 -->
        <service
            android:name=".ui.plan.PlanTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="plan_stopwatch" />
        </service>

        <!-- 计划到达每日目标的精确闹钟提醒（进程被杀也能触发） -->
        <receiver
            android:name=".notify.PlanGoalReceiver"
            android:exported="false" />

        <!-- 任务到期提醒广播接收器 -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <!-- 开机后重新注册提醒 -->
        <receiver
            android:name=".notify.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 番茄完成通知的快捷按钮（开始休息 / 再来一个 / 稍后提醒） -->
        <receiver
            android:name=".notify.TimerActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focuslist.app.action.TIMER_START_BREAK" />
                <action android:name="com.focuslist.app.action.TIMER_START_NEXT" />
                <action android:name="com.focuslist.app.action.TIMER_SNOOZE" />
            </intent-filter>
        </receiver>

        <!-- 稍后提醒到点 -->
        <receiver
            android:name=".notify.TimerSnoozeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focuslist.app.action.TIMER_SNOOZE_FIRE" />
            </intent-filter>
        </receiver>

        <!-- 计划提醒「停止响铃」广播 -->
        <receiver
            android:name=".notify.PlanAlertStopReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focuslist.app.action.STOP_PLAN_ALERT" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：今日计划（2x1 横向） -->
        <receiver
            android:name=".widget.plan.PlanWidgetWideProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/plan_widget_wide_info" />
        </receiver>

        <!-- 桌面小组件：今日计划（1x2 纵向） -->
        <receiver
            android:name=".widget.plan.PlanWidgetTallProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/plan_widget_tall_info" />
        </receiver>

    </application>

</manifest>